# Copie este arquivo para .env e preencha com suas chaves.
TELEGRAM_TOKEN=seu_token_do_telegram

# Provedor principal opcional.
GEMINI_API_KEY=sua_chave_do_gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# Banco local ou Supabase/Postgres.
DATABASE_PATH=dnd.db
# SUPABASE_DB_URL=postgresql://postgres:[SENHA]@db.[PROJETO].supabase.co:5432/postgres?sslmode=require

# Provedor OpenAI-compatible (Groq, OpenRouter ou outro).
AI_API_KEY=sua_chave_de_api_compatível
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Bastião local (Ollama/LM Studio/API OpenAI-compatible).
# Para Ollama sem autenticação, use BASTIAO_API_KEY=ollama.
# O Railway precisa alcançar esta URL por VPN/túnel seguro; localhost não funciona.
BASTIAO_API_KEY=ollama
BASTIAO_BASE_URL=http://127.0.0.1:11434/v1
BASTIAO_MODEL=qwen2.5:7b

# Cooldown aplicado após erro de provedor, em segundos.
AI_PROVIDER_COOLDOWN=300

# Opcional, para redes que bloqueiam api.telegram.org.
TELEGRAM_PROXY=socks5://127.0.0.1:1080
